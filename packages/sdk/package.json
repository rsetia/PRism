{
  "name": "@rsetia/prism",
  "version": "0.1.0-alpha.0",
  "description": "Prism — an agent-graph SDK: compile and run dependency graphs of tasks with bounded concurrency, failure-classified retry, cancellation, durable resume, and streamed events.",
  "keywords": [
    "agent",
    "agents",
    "agent-graph",
    "graph",
    "dag",
    "orchestration",
    "workflow",
    "pipeline",
    "task-runner",
    "engine"
  ],
  "license": "MIT",
  "author": "Ravpreet Setia <ravpreetsetia@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsetia/PRism.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/rsetia/PRism#readme",
  "bugs": "https://github.com/rsetia/PRism/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "peerDependencies": {
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false
}
